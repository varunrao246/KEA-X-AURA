# ==============================================================================
# KEA Platform — Environment Configuration Template
# ==============================================================================

# 1. Google Gemini (Primary Provider for Content Generation & Oral Evaluation)
# Obtain your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest

# 2. Groq LPU (Dedicated to Mock Interviews & Conversational Defense)
# Obtain your key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 3. NVIDIA NIM (Secondary Provider for Content Generation)
# Obtain your key at https://build.nvidia.com/
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.2-11b-vision-instruct

# 4. AI Orchestration & Fallback Cascade Policy
# Content generation: Gemini -> NVIDIA NIM -> Fallback
# Mock interviews: Groq -> Fallback
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDERS=nvidia,fallback

# Bounded timeouts & retries
AI_TIMEOUT_MS=25000
AI_MAX_RETRIES=1

# 5. SerpApi (Educational Resource Discovery & Concept 'Explore This')
# Obtain your key at https://serpapi.com/
SERPAPI_API_KEY=your_serpapi_api_key_here

